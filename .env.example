# Azure OpenAI configuration.
# Copy to .env and fill in, or export these in your shell before running.
# (Node loads .env automatically from v20.6 with --env-file, see README.)

AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-key-here

# The *deployment name* you created in Azure AI Foundry, not the model name.
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Optional. Defaults to 2024-10-21.
AZURE_OPENAI_API_VERSION=2024-10-21

# Set to true if the deployment is a reasoning model (o-series, gpt-5).
# Reasoning deployments take reasoning_effort + max_completion_tokens and
# reject temperature; standard chat deployments are the other way round.
AZURE_OPENAI_REASONING=false

# Optional: your own Azure token rates, for the cost line in the run summary.
# Left unset, the demo prints "set rates to estimate" rather than guessing -
# a wrong cost quoted to a customer is worse than no cost.
# AZURE_INPUT_USD_PER_1M=
# AZURE_OUTPUT_USD_PER_1M=
# AZURE_CACHED_INPUT_USD_PER_1M=
